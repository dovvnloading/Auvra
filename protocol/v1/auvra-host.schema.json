{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://auvra.dev/protocol/v1/auvra-host.schema.json",
  "title": "Auvra host protocol v1",
  "description": "Strict messages exchanged between the Auvra editor and its host.",
  "oneOf": [{"$ref":"#/$defs/request"},{"$ref":"#/$defs/successResponse"},{"$ref":"#/$defs/errorResponse"},{"$ref":"#/$defs/event"},{"$ref":"#/$defs/session"}],
  "$defs": {
    "protocol": {"const":"auvra.host/1"},
    "id": {"type":"string","minLength":1,"maxLength":128,"pattern":"^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "handle": {"type":"string","minLength":1,"maxLength":128,"pattern":"^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "revision": {"type":"integer","minimum":0,"maximum":9007199254740991},
    "sessionId": {"type":"string","minLength":1,"maxLength":128,"pattern":"^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "projectId": {"type":"string","minLength":1,"maxLength":128,"pattern":"^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "name": {"type":"string","minLength":1,"maxLength":128,"pattern":"^[^\\\\/:*?\"<>|\\r\\n]+$"},
    "sha256": {"type":"string","pattern":"^[A-Fa-f0-9]{64}$"},
    "mime": {"type":"string","minLength":1,"maxLength":127,"pattern":"^[A-Za-z0-9!#$&^_.+-]+/[A-Za-z0-9!#$&^_.+-]+$"},
    "emptyObject": {"type":"object","properties":{},"required":[],"additionalProperties":false},
    "jsonValue": {"oneOf":[{"type":"null"},{"type":"boolean"},{"type":"string","maxLength":1048576,"not":{"pattern":"^(?:[A-Za-z]:[\\\\/]|\\\\\\\\|file://|/)"}},{"type":"number"},{"type":"array","items":{"$ref":"#/$defs/jsonValue"},"maxItems":100000},{"type":"object","propertyNames":{"not":{"pattern":"^(?:path|filepath|filesystempath|sourcepath|assetpath|directorypath|absolutepath|localpath|base64|binary|bytes|blob)$"}},"additionalProperties":{"$ref":"#/$defs/jsonValue"},"maxProperties":10000}]},
    "projectRef": {"type":"object","required":["projectId"],"properties":{"projectId":{"$ref":"#/$defs/projectId"}},"additionalProperties":false},
    "mutationRef": {"type":"object","required":["projectId","expectedRevision"],"properties":{"projectId":{"$ref":"#/$defs/projectId"},"expectedRevision":{"$ref":"#/$defs/revision"}},"additionalProperties":false},
    "request": {
      "type":"object","required":["protocol","type","id","session","revision","method","payload"],"additionalProperties":false,
      "properties":{"protocol":{"$ref":"#/$defs/protocol"},"type":{"const":"request"},"id":{"$ref":"#/$defs/id"},"session":{"$ref":"#/$defs/sessionId"},"revision":{"$ref":"#/$defs/revision"},"method":{"enum":["host.ping","host.getCapabilities","project.getStatus","project.create","project.open","project.openRecent","project.close","project.getSnapshot","project.applyChanges","project.save","project.saveAs","project.exportPack","project.importPack","project.importLegacy","asset.beginUpload","asset.resolve"]},"payload":{"type":"object"}},
      "allOf":[
        {"if":{"properties":{"method":{"enum":["host.ping","host.getCapabilities"]}}},"then":{"properties":{"payload":{"$ref":"#/$defs/emptyObject"}}}},
        {"if":{"properties":{"method":{"const":"project.getStatus"}}},"then":{"properties":{"payload":{"$ref":"#/$defs/projectStatusPayload"}}}},
        {"if":{"properties":{"method":{"const":"project.create"}}},"then":{"properties":{"payload":{"$ref":"#/$defs/projectCreatePayload"}}}},
        {"if":{"properties":{"method":{"const":"project.open"}}},"then":{"properties":{"payload":{"$ref":"#/$defs/projectOpenPayload"}}}},
        {"if":{"properties":{"method":{"const":"project.openRecent"}}},"then":{"properties":{"payload":{"$ref":"#/$defs/projectRecentPayload"}}}},
        {"if":{"properties":{"method":{"const":"project.close"}}},"then":{"properties":{"payload":{"$ref":"#/$defs/closePayload"}}}},
        {"if":{"properties":{"method":{"const":"project.getSnapshot"}}},"then":{"properties":{"payload":{"$ref":"#/$defs/snapshotPayload"}}}},
        {"if":{"properties":{"method":{"const":"project.applyChanges"}}},"then":{"properties":{"payload":{"$ref":"#/$defs/applyChangesPayload"}}}},
        {"if":{"properties":{"method":{"const":"project.save"}}},"then":{"properties":{"payload":{"$ref":"#/$defs/savePayload"}}}},
        {"if":{"properties":{"method":{"const":"project.saveAs"}}},"then":{"properties":{"payload":{"$ref":"#/$defs/saveAsPayload"}}}},
        {"if":{"properties":{"method":{"const":"project.exportPack"}}},"then":{"properties":{"payload":{"$ref":"#/$defs/exportPayload"}}}},
        {"if":{"properties":{"method":{"const":"project.importPack"}}},"then":{"properties":{"payload":{"$ref":"#/$defs/importPackPayload"}}}},
        {"if":{"properties":{"method":{"const":"project.importLegacy"}}},"then":{"properties":{"payload":{"$ref":"#/$defs/importLegacyPayload"}}}},
        {"if":{"properties":{"method":{"const":"asset.beginUpload"}}},"then":{"properties":{"payload":{"$ref":"#/$defs/uploadPayload"}}}},
        {"if":{"properties":{"method":{"const":"asset.resolve"}}},"then":{"properties":{"payload":{"$ref":"#/$defs/assetResolvePayload"}}}}
      ]
    },
    "projectStatusPayload": {"oneOf":[{"$ref":"#/$defs/emptyObject"},{"type":"object","required":["projectId"],"properties":{"projectId":{"$ref":"#/$defs/projectId"}},"additionalProperties":false}]},
    "projectCreatePayload": {"type":"object","required":["name"],"properties":{"name":{"$ref":"#/$defs/name"},"parentHandle":{"$ref":"#/$defs/handle"}},"additionalProperties":false},
    "projectOpenPayload": {"type":"object","required":["projectHandle"],"properties":{"projectHandle":{"$ref":"#/$defs/handle"},"recoveryId":{"$ref":"#/$defs/handle"}},"additionalProperties":false},
    "projectRecentPayload": {"type":"object","required":["recentId"],"properties":{"recentId":{"$ref":"#/$defs/handle"},"recoveryId":{"$ref":"#/$defs/handle"}},"additionalProperties":false},
    "closePayload": {"type":"object","required":["projectId","expectedRevision"],"properties":{"projectId":{"$ref":"#/$defs/projectId"},"expectedRevision":{"$ref":"#/$defs/revision"}},"additionalProperties":false},
    "snapshotPayload": {"type":"object","required":["projectId"],"properties":{"projectId":{"$ref":"#/$defs/projectId"},"domain":{"type":"string","minLength":1,"maxLength":128,"pattern":"^[A-Za-z][A-Za-z0-9._-]*$"},"cursor":{"type":"string","maxLength":256},"pageSize":{"type":"integer","minimum":1,"maximum":1000}},"additionalProperties":false},
    "applyChangesPayload": {"type":"object","required":["projectId","expectedRevision","changes"],"properties":{"projectId":{"$ref":"#/$defs/projectId"},"expectedRevision":{"$ref":"#/$defs/revision"},"changes":{"type":"array","minItems":1,"maxItems":10000,"items":{"type":"object","required":["domain","documentId","operation"],"properties":{"domain":{"type":"string","minLength":1,"maxLength":128,"pattern":"^[A-Za-z][A-Za-z0-9._-]*$"},"documentId":{"$ref":"#/$defs/id"},"operation":{"enum":["upsert","replace","remove"]},"document":{"$ref":"#/$defs/jsonValue"}},"additionalProperties":false}}},"additionalProperties":false},
    "savePayload": {"type":"object","required":["projectId","expectedRevision"],"properties":{"projectId":{"$ref":"#/$defs/projectId"},"expectedRevision":{"$ref":"#/$defs/revision"}},"additionalProperties":false},
    "saveAsPayload": {"type":"object","required":["projectId","expectedRevision","name"],"properties":{"projectId":{"$ref":"#/$defs/projectId"},"expectedRevision":{"$ref":"#/$defs/revision"},"name":{"$ref":"#/$defs/name"},"parentHandle":{"$ref":"#/$defs/handle"}},"additionalProperties":false},
    "exportPayload": {"type":"object","required":["projectId","expectedRevision"],"properties":{"projectId":{"$ref":"#/$defs/projectId"},"expectedRevision":{"$ref":"#/$defs/revision"},"destinationHandle":{"$ref":"#/$defs/handle"}},"additionalProperties":false},
    "importPackPayload": {"type":"object","required":["sourceHandle"],"properties":{"sourceHandle":{"$ref":"#/$defs/handle"},"name":{"$ref":"#/$defs/name"},"parentHandle":{"$ref":"#/$defs/handle"}},"additionalProperties":false},
    "importLegacyPayload": {"type":"object","required":["sourceHandle"],"properties":{"sourceHandle":{"$ref":"#/$defs/handle"},"name":{"$ref":"#/$defs/name"},"parentHandle":{"$ref":"#/$defs/handle"}},"additionalProperties":false},
    "uploadPayload": {"type":"object","required":["projectId","expectedRevision","size","mime","name"],"properties":{"projectId":{"$ref":"#/$defs/projectId"},"expectedRevision":{"$ref":"#/$defs/revision"},"size":{"type":"integer","minimum":1,"maximum":2147483648},"mime":{"$ref":"#/$defs/mime"},"name":{"$ref":"#/$defs/name"}},"additionalProperties":false},
    "assetResolvePayload": {"type":"object","required":["projectId","assetId"],"properties":{"projectId":{"$ref":"#/$defs/projectId"},"assetId":{"$ref":"#/$defs/sha256"}},"additionalProperties":false},
    "projectResult": {"type":"object","required":["projectId"],"properties":{"projectId":{"type":["string","null"],"maxLength":128},"revision":{"$ref":"#/$defs/revision"},"name":{"type":["string","null"],"maxLength":128},"readOnly":{"type":"boolean"},"dirty":{"type":"boolean"},"busy":{"type":"boolean"},"progress":{"type":["number","null"],"minimum":0,"maximum":1},"recoveryAvailable":{"type":"boolean"},"recoveryId":{"$ref":"#/$defs/handle"},"recoveryKind":{"enum":["manual","autosave"]},"recoveryPoints":{"type":"array","maxItems":32,"items":{"type":"object","required":["recoveryId","kind"],"properties":{"recoveryId":{"$ref":"#/$defs/handle"},"kind":{"enum":["manual","autosave"]},"size":{"type":"integer","minimum":0}},"additionalProperties":false}},"recentProjects":{"type":"array","maxItems":256,"items":{"type":"object","required":["projectId","name"],"properties":{"projectId":{"$ref":"#/$defs/projectId"},"name":{"type":"string","maxLength":128}},"additionalProperties":false}},"status":{"enum":["closed","opening","open","saving","recovering"]},"domains":{"oneOf":[{"type":"array","items":{"type":"string","maxLength":128},"maxItems":256},{"type":"object","propertyNames":{"not":{"pattern":"^(?:path|filepath|filesystempath|sourcepath|assetpath|directorypath|absolutepath|localpath|base64|binary|bytes|blob)$"}},"additionalProperties":{"$ref":"#/$defs/jsonValue"},"maxProperties":256}]},"documents":{"type":"array","items":{"$ref":"#/$defs/jsonValue"},"maxItems":256},"cursor":{"type":"string","maxLength":256},"hasMore":{"type":"boolean"},"handle":{"$ref":"#/$defs/handle"},"uploadId":{"$ref":"#/$defs/handle"},"expiresAt":{"type":"number","minimum":0},"method":{"enum":["GET","PUT"]},"url":{"type":"string","pattern":"^https://assets\\.auvra\\.local/v1/(?:get|put)/[A-Za-z0-9_-]{43}$"},"assetId":{"$ref":"#/$defs/sha256"},"size":{"type":"integer","minimum":0},"sha256":{"$ref":"#/$defs/sha256"},"mime":{"$ref":"#/$defs/mime"},"report":{"type":"object","propertyNames":{"not":{"pattern":"^(?:path|filepath|filesystempath|sourcepath|assetpath|directorypath|absolutepath|localpath|base64|binary|bytes|blob)$"}},"additionalProperties":{"$ref":"#/$defs/jsonValue"}}},"additionalProperties":false},
    "successResponse": {"type":"object","required":["protocol","type","id","session","revision","ok","result"],"properties":{"protocol":{"$ref":"#/$defs/protocol"},"type":{"const":"response"},"id":{"$ref":"#/$defs/id"},"session":{"$ref":"#/$defs/sessionId"},"revision":{"$ref":"#/$defs/revision"},"ok":{"const":true},"result":{"oneOf":[{"$ref":"#/$defs/pingResult"},{"$ref":"#/$defs/capabilitiesResult"},{"$ref":"#/$defs/projectResult"}]}},"additionalProperties":false},
    "pingResult": {"type":"object","required":["pong"],"properties":{"pong":{"const":true}},"additionalProperties":false},
    "capabilitiesResult": {"type":"object","required":["protocol","methods"],"properties":{"protocol":{"$ref":"#/$defs/protocol"},"methods":{"type":"array","minItems":2,"maxItems":2,"prefixItems":[{"const":"host.ping"},{"const":"host.getCapabilities"}],"items":false},"projectMethods":{"type":"array","minItems":14,"maxItems":14,"items":{"enum":["project.getStatus","project.create","project.open","project.openRecent","project.close","project.getSnapshot","project.applyChanges","project.save","project.saveAs","project.exportPack","project.importPack","project.importLegacy","asset.beginUpload","asset.resolve"]}}},"additionalProperties":false},
    "errorCode": {"enum":["invalid_request","invalid_response","session_mismatch","unknown_method","revision_conflict","cancelled","locking","read_only","invalid_project","unsupported_version","migration_failed","disk_failure","permission_denied","recovery_required","internal_error"]},
    "error": {"type":"object","required":["code","message"],"properties":{"code":{"$ref":"#/$defs/errorCode"},"message":{"type":"string","minLength":1,"maxLength":256},"details":{"type":"object","properties":{"projectId":{"$ref":"#/$defs/projectId"},"expectedRevision":{"$ref":"#/$defs/revision"},"actualRevision":{"$ref":"#/$defs/revision"},"recoveries":{"type":"integer","minimum":0,"maximum":32},"retryable":{"type":"boolean"}},"additionalProperties":false}},"additionalProperties":false},
    "errorResponse": {"type":"object","required":["protocol","type","id","session","revision","ok","error"],"properties":{"protocol":{"$ref":"#/$defs/protocol"},"type":{"const":"response"},"id":{"$ref":"#/$defs/id"},"session":{"$ref":"#/$defs/sessionId"},"revision":{"$ref":"#/$defs/revision"},"ok":{"const":false},"error":{"$ref":"#/$defs/error"}},"additionalProperties":false},
    "event": {"type":"object","required":["protocol","type","event","session","revision","payload"],"properties":{"protocol":{"$ref":"#/$defs/protocol"},"type":{"const":"event"},"event":{"enum":["host.session","host.revision","project.status","project.opening","project.opened","project.closing","project.closed","project.revision","project.dirty","project.readOnly","project.progress","project.recovery"]},"session":{"$ref":"#/$defs/sessionId"},"revision":{"$ref":"#/$defs/revision"},"payload":{"type":"object","properties":{"projectId":{"type":["string","null"],"maxLength":128},"revision":{"$ref":"#/$defs/revision"},"name":{"type":["string","null"],"maxLength":128},"dirty":{"type":"boolean"},"readOnly":{"type":"boolean"},"busy":{"type":"boolean"},"progress":{"type":["number","null"],"minimum":0,"maximum":1},"recoveryAvailable":{"type":"boolean"},"recoveryId":{"$ref":"#/$defs/handle"},"recoveryKind":{"enum":["manual","autosave"]},"recentProjects":{"type":"array","maxItems":256,"items":{"type":"object","required":["projectId","name"],"properties":{"projectId":{"$ref":"#/$defs/projectId"},"name":{"type":"string","maxLength":128}},"additionalProperties":false}},"status":{"enum":["closed","opening","open","saving","recovering"]},"domains":{"type":"object","maxProperties":256,"additionalProperties":{"$ref":"#/$defs/jsonValue"}},"dirtySince":{"type":"number","minimum":0},"operation":{"type":"string","maxLength":64},"available":{"type":"integer","minimum":0,"maximum":32}},"additionalProperties":false}},"additionalProperties":false},
    "session": {"type":"object","required":["protocol","type","session","revision","status"],"properties":{"protocol":{"$ref":"#/$defs/protocol"},"type":{"const":"session"},"session":{"$ref":"#/$defs/sessionId"},"revision":{"$ref":"#/$defs/revision"},"status":{"enum":["created","active","closed"]}},"additionalProperties":false}
  }
}
