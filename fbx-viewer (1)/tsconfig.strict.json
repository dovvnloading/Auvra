{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "strict": true,
    "noImplicitAny": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "allowJs": false,
    "skipLibCheck": true,
    "types": ["node", "vitest/globals"]
  },
  "include": [
    "tests/frontend/**/*.ts",
    "tests/frontend/**/*.tsx",
    "components/HUDEditor/types.ts",
    "components/UI/Select.tsx",
    "components/UI/Properties/ScrubbableInput.tsx",
    "renderer/registry.ts",
    "utils/editorSession.ts"
  ],
  "exclude": [
    "tests/frontend/attachmentController.test.tsx",
    "tests/frontend/contentBrowser.test.tsx",
    "tests/frontend/environmentScene.test.tsx",
    "tests/frontend/hudBindings.test.tsx",
    "tests/frontend/hudMenus.test.tsx",
    "tests/frontend/hudRenderer.test.tsx",
    "tests/frontend/hudSandbox.test.tsx",
    "tests/frontend/levelBlueprintMath.test.tsx",
    "tests/frontend/levelBlueprintNodesRuntime.test.tsx",
    "tests/frontend/levelBlueprintRuntime.test.tsx",
    "tests/frontend/levelClipboard.test.ts",
    "tests/frontend/levelHierarchyEdits.test.tsx",
    "tests/frontend/levelPersistence.test.tsx",
    "tests/frontend/modelTransforms.test.ts",
    "tests/frontend/playRuntimeWorld.test.ts",
    "tests/frontend/projectHydration.test.ts",
    "tests/frontend/saveGame.test.ts",
    "tests/frontend/terrainSplatPersistence.test.ts",
    "tests/frontend/triggers.test.ts"
  ]
}
